---
import Base from "@/layouts/Base.astro";
import { t } from "@/utils/translations";

import { getCollection } from "astro:content";

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'hi' } }
  ];
}

const { lang } = Astro.params;

const noticesData = await getCollection("notices");
const notices = noticesData.map(f => f.data);
if (notices.length === 0) {
  notices.push(
    { title: "Last date for MP State Scholarship extended to Oct 31.", date: "2026-09-15" },
    { title: "New Vacancy: MP Police Constable 2026 announced.", date: "2026-09-10" },
    { title: "Server maintenance for Samagra Portal this weekend.", date: "2026-09-08" }
  );
}
---

<Base>
  <section class="section pt-14">
    <div class="container text-center mb-12">
      <h1 class="text-h2 text-primary font-bold">{t(lang, 'nav.notices')}</h1>
    </div>

    <div class="container max-w-4xl">
      <div class="flex flex-col gap-4">
        {notices.map(notice => (
          <div class="bg-white border-l-4 border-primary p-6 rounded-r-xl shadow-sm">
            <h3 class="text-lg font-bold text-dark">{notice.title}</h3>
            <p class="text-sm text-text-light mt-2">{new Date(notice.date).toLocaleDateString()}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>