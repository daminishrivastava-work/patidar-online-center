---
import Base from "@/layouts/Base.astro";
import { t } from "@/utils/translations";

import { getCollection } from "astro:content";

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'hi' } }
  ];
}

const { lang } = Astro.params;

const vacanciesData = await getCollection("vacancies");
const vacancies = vacanciesData.map(f => f.data);
if (vacancies.length === 0) {
  vacancies.push(
    { title: "MP Police Constable 2026", category: "Government Jobs", endDate: "2026-11-20" },
    { title: "SBI Clerk Recruitment", category: "Banking", endDate: "2026-10-15" },
    { title: "Railway Group D", category: "Government Jobs", endDate: "2026-12-01" }
  );
}
---

<Base>
  <section class="section pt-14">
    <div class="container text-center mb-12">
      <h1 class="text-h2 text-primary font-bold">{t(lang, 'nav.vacancies')}</h1>
    </div>

    <div class="container">
      <div class="bg-white rounded-2xl shadow-sm border border-border p-6 overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-light text-dark">
              <th class="p-4 rounded-tl-lg font-bold">{t(lang, 'common.postName')}</th>
              <th class="p-4 font-bold">{t(lang, 'common.category')}</th>
              <th class="p-4 font-bold">{t(lang, 'common.lastDate')}</th>
              <th class="p-4 rounded-tr-lg font-bold">{t(lang, 'common.action')}</th>
            </tr>
          </thead>
          <tbody>
            {vacancies.map(vacancy => (
              <tr class="border-b border-border hover:bg-light/50 transition-colors">
                <td class="p-4 font-medium text-dark">{vacancy.title}</td>
                <td class="p-4 text-text-light"><span class="bg-primary-light/10 text-primary px-3 py-1 rounded-full text-xs font-bold">{vacancy.category}</span></td>
                <td class="p-4 text-secondary font-semibold">{new Date(vacancy.endDate).toLocaleDateString()}</td>
                <td class="p-4">
                  <a href={`/${lang}/contact`} class="btn btn-primary btn-sm whitespace-nowrap">
                    {t(lang, 'common.requestService')}
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>