---
import Base from "@/layouts/Base.astro";
import { t } from "@/utils/translations";
import config from "@/config/config.json";

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'hi' } }
  ];
}

const { lang } = Astro.params;
const { footer_phone, footer_email, footer_address } = config.params;
---

<Base>
  <section class="section pt-14">
    <div class="container text-center mb-12">
      <h1 class="text-h2 text-primary font-bold">{t(lang, 'nav.contact')} / {t(lang, 'common.requestService')}</h1>
      <p class="text-lg text-text-light mt-4">{t(lang, 'contact.subtitle')}</p>
    </div>

    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-border mb-8">
            <h3 class="text-xl font-bold mb-6 text-dark">{t(lang, 'contact.businessInfo')}</h3>
            <div class="mb-6 rounded-xl overflow-hidden shadow-sm flex items-center justify-center bg-light/50 py-4">
              <img src="/images/profile.jpg" alt="Patidar Online Center Owner" class="w-32 h-32 rounded-full object-cover shadow-md border-4 border-white" />
            </div>
            <div class="flex flex-col gap-6">
              {config.params.branches.map((branch: any) => (
                <div class="bg-light/30 p-4 rounded-xl border border-border">
                  <h4 class="font-bold text-lg mb-2 text-primary">{branch.name}</h4>
                  <ul class="flex flex-col gap-3">
                    <li class="flex items-start gap-3">
                      <span class="text-secondary mt-1"><svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg></span>
                      <div>
                        <strong class="text-sm">{t(lang, 'contact.address')}</strong>
                        <p class="text-text-light text-sm">{branch.address}</p>
                      </div>
                    </li>
                    <li class="flex items-center gap-3">
                      <span class="text-secondary"><svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg></span>
                      <div>
                        <strong class="text-sm">{t(lang, 'contact.phone')}</strong>
                        <p class="text-text-light text-sm"><a href={`tel:${branch.phone}`} class="hover:text-primary">{branch.phone}</a></p>
                      </div>
                    </li>
                  </ul>
                </div>
              ))}
              
              <div class="bg-light/30 p-4 rounded-xl border border-border flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="text-secondary"><svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg></span>
                  <div>
                    <strong class="text-sm">{t(lang, 'contact.email')}</strong>
                    <p class="text-text-light text-sm"><a href={`mailto:${config.params.footer_email}`} class="hover:text-primary">{config.params.footer_email}</a></p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-border">
            <h3 class="text-xl font-bold mb-6 text-dark">{t(lang, 'common.checkStatus')}</h3>
            <form action="#" method="get" class="flex flex-col gap-4">
              <input type="text" class="form-input w-full" placeholder={t(lang, 'contact.enterRequestId')} required />
              <button type="submit" class="btn btn-outline border-primary text-primary w-full">{t(lang, 'contact.trackStatus')}</button>
            </form>
          </div>
        </div>

        <!-- Service Request Form -->
        <div>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-border h-full">
            <h3 class="text-xl font-bold mb-6 text-dark">{t(lang, 'contact.submitRequest')}</h3>
            <form action="#" method="post" class="flex flex-col gap-5">
              <div>
                <label class="form-label block mb-2 font-medium">{t(lang, 'contact.fullName')} <span class="text-red-500">*</span></label>
                <input type="text" class="form-input w-full" required />
              </div>
              
              <div>
                <label class="form-label block mb-2 font-medium">{t(lang, 'contact.phoneNumber')} <span class="text-red-500">*</span></label>
                <input type="tel" class="form-input w-full" required />
              </div>
              
              <div>
                <label class="form-label block mb-2 font-medium">{t(lang, 'contact.serviceRequested')} <span class="text-red-500">*</span></label>
                <input type="text" class="form-input w-full" placeholder={t(lang, 'contact.servicePlaceholder')} required />
              </div>

              <div>
                <label class="form-label block mb-2 font-medium">{t(lang, 'contact.uploadDocs')}</label>
                <div class="border-2 border-dashed border-border rounded-xl p-8 text-center cursor-pointer hover:border-primary transition-colors bg-light/50">
                  <svg class="size-8 mx-auto text-text-light mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                  <p class="text-sm text-text-light">Drag & drop files here or click to browse</p>
                </div>
              </div>
              
              <button type="submit" class="btn btn-primary w-full mt-2" onclick="alert('This is a frontend demo. Service Request submitted successfully!')">{t(lang, 'contact.submitBtn')}</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>