---
import Base from "@/layouts/Base.astro";
import { t } from "@/utils/translations";
import config from "@/config/config.json";
import CurrentJobsTicker from "@/components/CurrentJobsTicker.astro";
import JobCategoryTabs from "@/components/JobCategoryTabs.astro";
import OfflineFormsStore from "@/components/OfflineFormsStore.astro";

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'hi' } }
  ];
}

const { lang } = Astro.params;
const currentLang = (lang === 'hi' || lang === 'en') ? lang : 'en';
---

<Base>
  <!-- 1. Top Running Ticker ("Current Jobs" Marquee) -->
  <CurrentJobsTicker lang={currentLang} />

  <!-- Hero Section -->
  <section class="section-ph relative overflow-hidden bg-body py-10 md:py-16">
    <div class="container relative z-10 text-center">
      <div class="mb-8 md:mb-10">
        <h1 class="text-h2 md:text-h1 mb-4 text-primary font-black tracking-tight">
          {t(currentLang, 'home.welcome')}
        </h1>
        <p class="text-lg md:text-xl text-text-dark max-w-3xl mx-auto leading-relaxed">
          {t(currentLang, 'home.subtitle')}
        </p>
      </div>

      <!-- Quick Action Buttons including Offline Store -->
      <div class="flex flex-wrap gap-3 sm:gap-4 justify-center items-center">
        <a href="#offline-forms" class="btn bg-secondary text-white hover:bg-secondary-dark rounded-xl px-6 py-3 font-extrabold shadow-lg hover:-translate-y-1 transition-all flex items-center gap-2">
          <span>📮</span>
          <span>{currentLang === 'hi' ? 'ऑफलाइन फॉर्म स्टोर (₹20)' : 'Offline Forms Store (₹20)'}</span>
        </a>
        <a href="#job-portal-section" class="btn btn-primary rounded-xl px-6 py-3 shadow-md hover:-translate-y-1 transition-transform">
          {t(currentLang, 'portal.allCategories')}
        </a>
        <a href={`/${currentLang}/services`} class="btn btn-outline border-primary text-primary hover:bg-primary hover:text-white rounded-xl px-6 py-3 hover:-translate-y-1 transition-transform">
          {t(currentLang, 'nav.services')}
        </a>
        <a href={`/${currentLang}/contact`} class="btn btn-outline border-secondary text-secondary hover:bg-secondary hover:text-white rounded-xl px-6 py-3 hover:-translate-y-1 transition-transform">
          {t(currentLang, 'nav.contact')}
        </a>
      </div>
    </div>
    
    <!-- Background Decor -->
    <div class="absolute inset-0 grid place-items-center size-full -z-10 opacity-30 pointer-events-none">
        <div class="size-180 xl:size-225 bg-radial from-primary-light/40 to-transparent from-0% to-70% rounded-full"></div>
    </div>
  </section>

  <!-- 2. Streamlined Category & State Navigation Tabs & Online Jobs Grid ("Top Most Online") -->
  <JobCategoryTabs lang={currentLang} />

  <!-- 3. Paid Offline / Manual Job Application Form Store (Core Monetization Feature) -->
  <OfflineFormsStore lang={currentLang} />

  <!-- Important Forms (Colorful Quick Access Boxes) -->
  <section class="section py-12 bg-light/50 border-b border-border">
    <div class="container">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-dark">Quick Portal Shortcuts</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {[
          { title: "MP Police", label: "Constable 2026", color: "bg-red-500", link: `/${currentLang}/vacancies` },
          { title: "Railway", label: "Group D / NTPC", color: "bg-blue-500", link: `/${currentLang}/vacancies` },
          { title: "SSC", label: "CGL / CHSL", color: "bg-green-500", link: `/${currentLang}/vacancies` },
          { title: "Postal Dept", label: "GDS Recruitment", color: "bg-orange-500", link: `/${currentLang}/vacancies` },
          { title: "MP State Scholarship", label: "Pre/Post Matric", color: "bg-purple-500", link: `/${currentLang}/services` },
          { title: "Samagra e-KYC", label: "Mandatory Update", color: "bg-teal-500", link: `/${currentLang}/services` },
          { title: "Vyapam", label: "MPESB Exams", color: "bg-indigo-500", link: `/${currentLang}/vacancies` },
          { title: "College Admission", label: "e-Pravesh", color: "bg-pink-500", link: `/${currentLang}/services` }
        ].map(form => (
          <a href={form.link} class="block p-5 rounded-xl shadow-xs hover:shadow-md transition-all hover:-translate-y-1 text-center bg-white border border-border group overflow-hidden relative">
             <div class={`absolute top-0 left-0 w-full h-1 ${form.color}`}></div>
             <h3 class="font-bold text-base sm:text-lg text-dark mb-1 mt-2 group-hover:text-primary transition-colors">{form.title}</h3>
             <span class="inline-block px-2 py-0.5 bg-light rounded text-xs font-semibold text-text-light mb-2">{form.label}</span>
             <div class="text-xs font-bold text-primary flex items-center justify-center gap-1 group-hover:gap-2 transition-all">
               View <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
             </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3-Column: Latest Jobs, Admit Card, Results -->
  <section class="py-12 bg-white border-b border-border">
    <div class="container">
      <div class="grid md:grid-cols-3 gap-6">
        <!-- Latest Jobs -->
        <div class="border-2 border-primary/20 rounded-2xl overflow-hidden flex flex-col h-full bg-white shadow-xs">
          <div class="bg-primary text-white p-3.5 font-bold text-center text-base md:text-lg shadow-sm">
            {currentLang === 'hi' ? 'नवीनतम नौकरियां' : 'Latest Jobs'}
          </div>
          <ul class="divide-y divide-border p-4 flex-1 flex flex-col gap-2">
            <li><a href={`/${currentLang}/vacancies`} class="text-xs sm:text-sm font-semibold text-primary hover:underline block py-1">➤ MP Police Constable Online Form 2026</a></li>
            <li><a href={`/${currentLang}/vacancies`} class="text-xs sm:text-sm font-semibold text-primary hover:underline block py-1">➤ Railway Group D Recruitment 2026</a></li>
            <li><a href={`/${currentLang}/vacancies`} class="text-xs sm:text-sm font-semibold text-primary hover:underline block py-1">➤ SSC CHSL 10+2 Online Form</a></li>
            <li><a href={`/${currentLang}/vacancies`} class="text-xs sm:text-sm font-semibold text-primary hover:underline block py-1">➤ MP Postal GDS Online Form</a></li>
          </ul>
        </div>
        
        <!-- Admit Card -->
        <div class="border-2 border-secondary/20 rounded-2xl overflow-hidden flex flex-col h-full bg-white shadow-xs">
          <div class="bg-secondary text-white p-3.5 font-bold text-center text-base md:text-lg shadow-sm">
            {currentLang === 'hi' ? 'प्रवेश पत्र (Admit Card)' : 'Admit Card'}
          </div>
          <ul class="divide-y divide-border p-4 flex-1 flex flex-col gap-2">
            <li><a href={`/${currentLang}/vacancies`} class="text-xs sm:text-sm font-semibold text-secondary hover:underline block py-1">➤ MPESB Police Constable Admit Card</a></li>
            <li><a href={`/${currentLang}/vacancies`} class="text-xs sm:text-sm font-semibold text-secondary hover:underline block py-1">➤ SSC CGL Tier 1 Admit Card</a></li>
            <li><a href={`/${currentLang}/vacancies`} class="text-xs sm:text-sm font-semibold text-secondary hover:underline block py-1">➤ Railway NTPC CBT 1 Admit Card</a></li>
          </ul>
        </div>
        
        <!-- Results -->
        <div class="border-2 border-green-600/20 rounded-2xl overflow-hidden flex flex-col h-full bg-white shadow-xs">
          <div class="bg-green-600 text-white p-3.5 font-bold text-center text-base md:text-lg shadow-sm">
            {currentLang === 'hi' ? 'परीक्षा परिणाम (Results)' : 'Results'}
          </div>
          <ul class="divide-y divide-border p-4 flex-1 flex flex-col gap-2">
            <li><a href={`/${currentLang}/vacancies`} class="text-xs sm:text-sm font-semibold text-green-700 hover:underline block py-1">➤ MP Board 10th/12th Result 2026</a></li>
            <li><a href={`/${currentLang}/vacancies`} class="text-xs sm:text-sm font-semibold text-green-700 hover:underline block py-1">➤ Vyapam Patwari Final Result</a></li>
            <li><a href={`/${currentLang}/vacancies`} class="text-xs sm:text-sm font-semibold text-green-700 hover:underline block py-1">➤ SSC GD Constable Result</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- About / Shopkeeper Profile Section -->
  <section class="section py-16 bg-light/30 border-b border-border">
    <div class="container">
      <div class="flex flex-col md:flex-row items-center gap-10 lg:gap-14">
        <div class="md:w-1/2 flex justify-center">
          <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white relative max-w-md w-full">
            <div class="absolute inset-0 bg-primary/10 rounded-2xl"></div>
            <img src="/images/profile.jpg" alt="Shopkeeper Profile" class="w-full h-auto object-cover rounded-2xl relative z-10 hover:scale-105 transition-transform duration-500" />
          </div>
        </div>
        <div class="md:w-1/2">
          <h2 class="text-secondary font-bold text-xs tracking-wider uppercase mb-2">{t(currentLang, 'home.aboutTitle')}</h2>
          <h3 class="text-2xl md:text-4xl font-black text-primary mb-5">{t(currentLang, 'home.meetOwner')}</h3>
          <p class="text-text-light text-base md:text-lg mb-6 leading-relaxed">
            {t(currentLang, 'home.aboutText')}
          </p>
          <ul class="space-y-3.5 mb-8">
            <li class="flex items-center text-dark font-medium text-sm md:text-base">
              <span class="mr-3 bg-secondary/10 text-secondary p-1.5 rounded-full"><svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              {t(currentLang, 'home.aboutPoint1')}
            </li>
            <li class="flex items-center text-dark font-medium text-sm md:text-base">
              <span class="mr-3 bg-secondary/10 text-secondary p-1.5 rounded-full"><svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              {t(currentLang, 'home.aboutPoint2')}
            </li>
            <li class="flex items-center text-dark font-medium text-sm md:text-base">
              <span class="mr-3 bg-secondary/10 text-secondary p-1.5 rounded-full"><svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              {t(currentLang, 'home.aboutPoint3')}
            </li>
          </ul>
          <a href={`/${currentLang}/contact`} class="btn btn-outline border-primary text-primary hover:bg-primary hover:text-white rounded-xl px-8">
            {t(currentLang, 'nav.contact')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services Grid -->
  <section class="section py-16 bg-white border-b border-border">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-black text-dark">{t(currentLang, 'home.coreServicesTitle')}</h2>
        <p class="text-text-light mt-2 max-w-2xl mx-auto">{t(currentLang, 'home.coreServicesSubtitle')}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Forms Card -->
        <a href={`/${currentLang}/forms`} class="block p-6 sm:p-8 bg-white rounded-2xl shadow-sm border border-border hover:shadow-xl hover:border-primary/40 transition-all hover:-translate-y-1">
          <div class="size-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary mb-5">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          </div>
          <h3 class="text-lg font-bold mb-2">{t(currentLang, 'nav.forms')}</h3>
          <p class="text-text-light text-xs sm:text-sm">{t(currentLang, 'home.formsDesc')}</p>
        </a>

        <!-- Vacancies Card -->
        <a href={`/${currentLang}/vacancies`} class="block p-6 sm:p-8 bg-white rounded-2xl shadow-sm border border-border hover:shadow-xl hover:border-primary/40 transition-all hover:-translate-y-1">
          <div class="size-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary mb-5">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-lg font-bold mb-2">{t(currentLang, 'nav.vacancies')}</h3>
          <p class="text-text-light text-xs sm:text-sm">{t(currentLang, 'home.vacanciesDesc')}</p>
        </a>

        <!-- Government Services Card -->
        <a href={`/${currentLang}/services`} class="block p-6 sm:p-8 bg-white rounded-2xl shadow-sm border border-border hover:shadow-xl hover:border-primary/40 transition-all hover:-translate-y-1">
          <div class="size-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary mb-5">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          </div>
          <h3 class="text-lg font-bold mb-2">{t(currentLang, 'nav.services')}</h3>
          <p class="text-text-light text-xs sm:text-sm">{t(currentLang, 'home.servicesDesc')}</p>
        </a>

        <!-- Status Card -->
        <a href={`/${currentLang}/contact`} class="block p-6 sm:p-8 bg-white rounded-2xl shadow-sm border border-border hover:shadow-xl hover:border-primary/40 transition-all hover:-translate-y-1">
          <div class="size-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary mb-5">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-lg font-bold mb-2">{t(currentLang, 'common.checkStatus')}</h3>
          <p class="text-text-light text-xs sm:text-sm">{t(currentLang, 'home.statusDesc')}</p>
        </a>
      </div>
    </div>
  </section>

  <!-- WhatsApp Group Banner -->
  <section class="py-12 bg-green-600 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] pointer-events-none"></div>
    <div class="container relative z-10 text-center">
      <h2 class="text-2xl md:text-4xl font-black text-white mb-3">Join Shahdol Rozgar Samachar WhatsApp Group</h2>
      <p class="text-white/90 text-sm md:text-base mb-6 max-w-2xl mx-auto">Get daily alerts on MP Government Jobs, offline recruitment forms, admit cards, and results directly on your phone.</p>
      <a href={config.params.whatsapp_group_url || `https://wa.me/91${config.params.whatsapp_number.replace(/\\D/g, '')}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-white text-green-700 font-extrabold text-base md:text-lg px-8 py-3.5 rounded-full shadow-xl hover:shadow-2xl hover:scale-105 transition-all">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12.031 0C5.394 0 0 5.394 0 12.031c0 2.126.551 4.195 1.594 6.015L.178 23.518l5.625-1.478A11.94 11.94 0 0012.031 24c6.634 0 12.031-5.396 12.031-12.031S18.667 0 12.031 0zm3.875 17.062c-.172.486-.984.939-1.391 1.016-.406.078-1.25.172-3.484-.75-2.687-1.109-4.391-3.844-4.516-4.016-.141-.172-1.078-1.437-1.078-2.734 0-1.297.672-1.937.906-2.187.234-.234.516-.297.688-.297.172 0 .344 0 .484.016.156.016.359-.063.562.438.219.531.75 1.828.812 1.953.063.125.109.281.016.469-.094.188-.141.313-.281.484-.141.172-.297.391-.422.516-.141.141-.297.297-.125.609.172.312.766 1.281 1.641 2.062.969.875 1.922 1.156 2.234 1.312.312.156.484.141.672-.078.188-.219.812-.953 1.031-1.281.219-.328.438-.266.719-.156.281.109 1.781.844 2.094 1.016.312.172.516.266.594.406.063.125.063.75-.109 1.234z"/></svg>
        Join WhatsApp Community
      </a>
    </div>
  </section>

</Base>
