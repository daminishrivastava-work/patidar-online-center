---
import Base from "@/layouts/Base.astro";
import { t } from "@/utils/translations";
import activeLinks from "@/config/notices.json";
import config from "@/config/config.json";

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'hi' } }
  ];
}

const { lang } = Astro.params;
---

<Base>
  <!-- Hero Section -->
  <section class="section-ph relative overflow-hidden bg-body">
    <div class="container relative z-10 text-center">
      <div class="mb-12">
        <h1 class="text-h2 md:text-h1 mb-6 text-primary font-bold">
          {t(lang, 'home.welcome')}
        </h1>
        <p class="text-xl text-text-dark max-w-3xl mx-auto">
          {t(lang, 'home.subtitle')}
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap gap-4 justify-center items-center">
        <a href={`/${lang}/forms`} class="btn btn-primary rounded-xl px-8 shadow-md hover:-translate-y-1 transition-transform">
          {t(lang, 'nav.forms')}
        </a>
        <a href={`/${lang}/services`} class="btn btn-primary rounded-xl px-8 shadow-md hover:-translate-y-1 transition-transform">
          {t(lang, 'nav.services')}
        </a>
        <a href={`/${lang}/contact`} class="btn btn-outline border-primary text-primary hover:bg-primary hover:text-white rounded-xl px-8 hover:-translate-y-1 transition-transform">
          {t(lang, 'nav.contact')}
        </a>
      </div>
    </div>
    
    <!-- Background Decor -->
    <div class="absolute inset-0 grid place-items-center size-full -z-10 opacity-30">
        <div class="size-180 xl:size-225 bg-radial from-primary-light/40 to-transparent from-0% to-70% rounded-full"></div>
    </div>
  </section>

  <!-- Active Links Horizontal Carousel -->
  <section class="py-4 bg-secondary text-white overflow-hidden border-y border-secondary relative shadow-sm">
    <div class="container-fluid relative flex items-center">
      <div class="font-bold text-sm md:text-base mr-4 shrink-0 px-4 z-10 bg-secondary h-full absolute left-0 flex items-center border-r border-white/20 shadow-[5px_0_10px_rgba(0,0,0,0.1)]">
        {t(lang, 'common.activeLinks')}
      </div>
      <div class="flex-1 overflow-hidden ml-24 md:ml-40">
        <div class="animate-marquee whitespace-nowrap flex gap-8 items-center">
          {activeLinks.map((link: any) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center hover:text-white/80 transition-colors font-medium">
              <span class="mr-2 text-white">●</span> {link.label}
            </a>
          ))}
          {/* Duplicate for seamless loop */}
          {activeLinks.map((link: any) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center hover:text-white/80 transition-colors font-medium">
              <span class="mr-2 text-white">●</span> {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Important Forms (Colorful Boxes) -->
  <section class="section py-12 bg-light/50">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {[
          { title: "MP Police", label: "Constable 2026", color: "bg-red-500", link: `/${lang}/vacancies` },
          { title: "Railway", label: "Group D / NTPC", color: "bg-blue-500", link: `/${lang}/vacancies` },
          { title: "SSC", label: "CGL / CHSL", color: "bg-green-500", link: `/${lang}/vacancies` },
          { title: "Postal Dept", label: "GDS Recruitment", color: "bg-orange-500", link: `/${lang}/vacancies` },
          { title: "MP State Scholarship", label: "Pre/Post Matric", color: "bg-purple-500", link: `/${lang}/services` },
          { title: "Samagra e-KYC", label: "Mandatory Update", color: "bg-teal-500", link: `/${lang}/services` },
          { title: "Vyapam", label: "MPESB Exams", color: "bg-indigo-500", link: `/${lang}/vacancies` },
          { title: "College Admission", label: "e-Pravesh", color: "bg-pink-500", link: `/${lang}/services` }
        ].map(form => (
          <a href={form.link} class="block p-5 rounded-xl shadow-sm hover:shadow-md transition-all hover:-translate-y-1 text-center bg-white border border-border group overflow-hidden relative">
             <div class={`absolute top-0 left-0 w-full h-1 ${form.color}`}></div>
             <h3 class="font-bold text-lg text-dark mb-1 mt-2 group-hover:text-primary transition-colors">{form.title}</h3>
             <span class="inline-block px-2 py-1 bg-light rounded text-xs font-semibold text-text-light mb-3">{form.label}</span>
             <div class="text-xs font-bold text-primary flex items-center justify-center gap-1 group-hover:gap-2 transition-all">View Details <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Jobs, Admit Card, Results 3-Column -->
  <section class="py-8 bg-white">
    <div class="container">
      <div class="grid md:grid-cols-3 gap-6">
        <!-- Latest Jobs -->
        <div class="border-2 border-primary/20 rounded-xl overflow-hidden flex flex-col h-full bg-white">
          <div class="bg-primary text-white p-3 font-bold text-center text-lg shadow-sm">Latest Jobs</div>
          <ul class="divide-y divide-border p-4 flex-1 flex flex-col gap-2">
            <li><a href={`/${lang}/vacancies`} class="text-sm font-semibold text-primary hover:underline block py-1">➤ MP Police Constable Online Form 2026</a></li>
            <li><a href={`/${lang}/vacancies`} class="text-sm font-semibold text-primary hover:underline block py-1">➤ Railway Group D Recruitment 2026</a></li>
            <li><a href={`/${lang}/vacancies`} class="text-sm font-semibold text-primary hover:underline block py-1">➤ SSC CHSL 10+2 Online Form</a></li>
            <li><a href={`/${lang}/vacancies`} class="text-sm font-semibold text-primary hover:underline block py-1">➤ MP Postal GDS Online Form</a></li>
          </ul>
        </div>
        
        <!-- Admit Card -->
        <div class="border-2 border-secondary/20 rounded-xl overflow-hidden flex flex-col h-full bg-white">
          <div class="bg-secondary text-white p-3 font-bold text-center text-lg shadow-sm">Admit Card</div>
          <ul class="divide-y divide-border p-4 flex-1 flex flex-col gap-2">
            <li><a href={`/${lang}/vacancies`} class="text-sm font-semibold text-secondary hover:underline block py-1">➤ MPESB Police Constable Admit Card</a></li>
            <li><a href={`/${lang}/vacancies`} class="text-sm font-semibold text-secondary hover:underline block py-1">➤ SSC CGL Tier 1 Admit Card</a></li>
            <li><a href={`/${lang}/vacancies`} class="text-sm font-semibold text-secondary hover:underline block py-1">➤ Railway NTPC CBT 1 Admit Card</a></li>
          </ul>
        </div>
        
        <!-- Results -->
        <div class="border-2 border-green-600/20 rounded-xl overflow-hidden flex flex-col h-full bg-white">
          <div class="bg-green-600 text-white p-3 font-bold text-center text-lg shadow-sm">Results</div>
          <ul class="divide-y divide-border p-4 flex-1 flex flex-col gap-2">
            <li><a href={`/${lang}/vacancies`} class="text-sm font-semibold text-green-700 hover:underline block py-1">➤ MP Board 10th/12th Result 2026</a></li>
            <li><a href={`/${lang}/vacancies`} class="text-sm font-semibold text-green-700 hover:underline block py-1">➤ Vyapam Patwari Final Result</a></li>
            <li><a href={`/${lang}/vacancies`} class="text-sm font-semibold text-green-700 hover:underline block py-1">➤ SSC GD Constable Result</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- About / Shopkeeper Profile Section -->
  <section class="section py-16 bg-white">
    <div class="container">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-1/2">
          <div class="rounded-2xl overflow-hidden shadow-2xl border-4 border-white relative">
            <div class="absolute inset-0 bg-primary/10 rounded-2xl"></div>
            <img src="/images/profile.jpg" alt="Shopkeeper Profile" class="w-full h-auto object-cover rounded-xl relative z-10 hover:scale-105 transition-transform duration-500" />
          </div>
        </div>
        <div class="md:w-1/2">
          <h2 class="text-secondary font-bold text-sm tracking-wider uppercase mb-2">{t(lang, 'home.aboutTitle')}</h2>
          <h3 class="text-3xl md:text-4xl font-bold text-primary mb-6">{t(lang, 'home.meetOwner')}</h3>
          <p class="text-text-light text-lg mb-6 leading-relaxed">
            {t(lang, 'home.aboutText')}
          </p>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center text-dark font-medium">
              <span class="mr-3 bg-secondary/10 text-secondary p-1.5 rounded-full"><svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              {t(lang, 'home.aboutPoint1')}
            </li>
            <li class="flex items-center text-dark font-medium">
              <span class="mr-3 bg-secondary/10 text-secondary p-1.5 rounded-full"><svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              {t(lang, 'home.aboutPoint2')}
            </li>
            <li class="flex items-center text-dark font-medium">
              <span class="mr-3 bg-secondary/10 text-secondary p-1.5 rounded-full"><svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></span>
              {t(lang, 'home.aboutPoint3')}
            </li>
          </ul>
          <a href={`/${lang}/contact`} class="btn btn-outline border-primary text-primary hover:bg-primary hover:text-white rounded-xl px-8">
            {t(lang, 'nav.contact')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services Grid -->
  <section class="section pt-20 pb-20 bg-light">
    <div class="container">
      <div class="text-center mb-16">
        <h2 class="text-h3 font-bold text-dark">{t(lang, 'home.coreServicesTitle')}</h2>
        <p class="text-text-light mt-2 max-w-2xl mx-auto">{t(lang, 'home.coreServicesSubtitle')}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Forms Card -->
        <a href={`/${lang}/forms`} class="block p-8 bg-white rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-border hover:shadow-[0_8px_30px_rgba(0,51,102,0.15)] hover:border-primary/30 transition-all hover:-translate-y-1">
          <div class="size-14 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-6">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">{t(lang, 'nav.forms')}</h3>
          <p class="text-text-light text-sm">{t(lang, 'home.formsDesc')}</p>
        </a>

        <!-- Vacancies Card -->
        <a href={`/${lang}/vacancies`} class="block p-8 bg-white rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-border hover:shadow-[0_8px_30px_rgba(0,51,102,0.15)] hover:border-primary/30 transition-all hover:-translate-y-1">
          <div class="size-14 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-6">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">{t(lang, 'nav.vacancies')}</h3>
          <p class="text-text-light text-sm">{t(lang, 'home.vacanciesDesc')}</p>
        </a>

        <!-- Government Services Card -->
        <a href={`/${lang}/services`} class="block p-8 bg-white rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-border hover:shadow-[0_8px_30px_rgba(0,51,102,0.15)] hover:border-primary/30 transition-all hover:-translate-y-1">
          <div class="size-14 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-6">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">{t(lang, 'nav.services')}</h3>
          <p class="text-text-light text-sm">{t(lang, 'home.servicesDesc')}</p>
        </a>

        <!-- Status Card -->
        <a href={`/${lang}/contact`} class="block p-8 bg-white rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-border hover:shadow-[0_8px_30px_rgba(0,51,102,0.15)] hover:border-primary/30 transition-all hover:-translate-y-1">
          <div class="size-14 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-6">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">{t(lang, 'common.checkStatus')}</h3>
          <p class="text-text-light text-sm">{t(lang, 'home.statusDesc')}</p>
        </a>
      </div>
    </div>
  </section>

  <!-- WhatsApp Group Banner -->
  <section class="py-12 bg-green-600 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
    <div class="container relative z-10 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Join Shahdol Rozgar Samachar WhatsApp Group</h2>
      <p class="text-white/90 text-lg mb-8 max-w-2xl mx-auto">Get daily updates on local jobs, MP recruitments, admit cards, and results directly on your phone.</p>
      <a href={config.params.whatsapp_group_url || `https://wa.me/91${config.params.whatsapp_number.replace(/\\D/g, '')}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-white text-green-700 font-bold text-lg px-8 py-4 rounded-full shadow-lg hover:shadow-2xl hover:scale-105 transition-all">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12.031 0C5.394 0 0 5.394 0 12.031c0 2.126.551 4.195 1.594 6.015L.178 23.518l5.625-1.478A11.94 11.94 0 0012.031 24c6.634 0 12.031-5.396 12.031-12.031S18.667 0 12.031 0zm3.875 17.062c-.172.486-.984.939-1.391 1.016-.406.078-1.25.172-3.484-.75-2.687-1.109-4.391-3.844-4.516-4.016-.141-.172-1.078-1.437-1.078-2.734 0-1.297.672-1.937.906-2.187.234-.234.516-.297.688-.297.172 0 .344 0 .484.016.156.016.359-.063.562.438.219.531.75 1.828.812 1.953.063.125.109.281.016.469-.094.188-.141.313-.281.484-.141.172-.297.391-.422.516-.141.141-.297.297-.125.609.172.312.766 1.281 1.641 2.062.969.875 1.922 1.156 2.234 1.312.312.156.484.141.672-.078.188-.219.812-.953 1.031-1.281.219-.328.438-.266.719-.156.281.109 1.781.844 2.094 1.016.312.172.516.266.594.406.063.125.063.75-.109 1.234z"/></svg>
        Join WhatsApp Group
      </a>
    </div>
  </section>

</Base>