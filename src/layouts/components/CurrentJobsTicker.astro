---
import currentJobs from "@/config/current_jobs.json";
import { t } from "@/utils/translations";

interface Props {
  lang: "en" | "hi";
}

const { lang } = Astro.props;
---

<div class="w-full bg-[#b91c1c] text-white border-b-2 border-red-800 shadow-sm relative z-30 select-none">
  <div class="w-full flex items-stretch overflow-hidden">
    <!-- Fixed Badge on the Left -->
    <div class="bg-[#8b0000] text-yellow-300 font-extrabold px-3 sm:px-6 py-2.5 text-xs sm:text-sm uppercase tracking-wider flex items-center gap-1.5 shrink-0 z-10 shadow-[4px_0_12px_rgba(0,0,0,0.3)] border-r border-red-950">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-yellow-400 animate-ping"></span>
      <svg class="w-4 h-4 fill-current hidden sm:inline-block" viewBox="0 0 24 24"><path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/></svg>
      <span>{t(lang, 'portal.currentJobs')}</span>
    </div>

    <!-- Running Marquee Track -->
    <div class="flex-1 overflow-hidden relative flex items-center py-2.5 group">
      <div class="inline-flex gap-8 whitespace-nowrap animate-marquee group-hover:[animation-play-state:paused] text-xs sm:text-sm">
        {currentJobs.map((job) => {
          const title = lang === 'hi' ? job.title_hi : job.title_en;
          const href = job.isOffline ? `#offline-forms` : `/${lang}/vacancies`;
          return (
            <a 
              href={href} 
              class="inline-flex items-center gap-2 text-white hover:text-yellow-300 transition-colors font-medium cursor-pointer"
            >
              <span class="bg-white/20 text-white font-bold text-[10px] px-2 py-0.5 rounded-sm uppercase tracking-wider">{job.tag}</span>
              <span class="hover:underline">{title}</span>
              <span class="text-yellow-300 font-bold ml-1">★</span>
            </a>
          );
        })}
        {/* Duplicate loop for seamless infinite marquee */}
        {currentJobs.map((job) => {
          const title = lang === 'hi' ? job.title_hi : job.title_en;
          const href = job.isOffline ? `#offline-forms` : `/${lang}/vacancies`;
          return (
            <a 
              href={href} 
              class="inline-flex items-center gap-2 text-white hover:text-yellow-300 transition-colors font-medium cursor-pointer"
            >
              <span class="bg-white/20 text-white font-bold text-[10px] px-2 py-0.5 rounded-sm uppercase tracking-wider">{job.tag}</span>
              <span class="hover:underline">{title}</span>
              <span class="text-yellow-300 font-bold ml-1">★</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</div>
